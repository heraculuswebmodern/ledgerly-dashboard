# Ledgerly runs with zero configuration. Everything below is optional.

# HMAC secret for signing session cookies (min 32 chars). Strongly recommended in any
# shared deployment. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Override the demo login (defaults: demo@ledgerly.app / ledgerly-demo).
# If you change these, the hint on the login page will no longer match.
DEMO_EMAIL=
DEMO_PASSWORD=

# Public URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://ledgerly-dashboard.vercel.app
